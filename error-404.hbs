{{!< default}}

<main id="main-content" class="error-page">
	<div class="error-page__globe" aria-hidden="true"></div>
	<div class="error-page__content">
		<p class="error-page__code">404</p>
		<h1>This route didn’t respond.</h1>
		<p>The page may have moved, but the Globalping network is still up. Search the blog or return to the latest stories.</p>
		<div class="error-page__actions">
			<a class="button button--primary" href="{{@site.url}}">Back to the blog</a>
			<button class="button button--secondary" type="button" data-ghost-search>Search articles</button>
		</div>
	</div>
</main>
