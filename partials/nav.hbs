<header class="site-header">
    <div class="site-header__inner">
        <a class="site-logo" href="{{@site.url}}" aria-label="Globalping blog home">
            <img src="{{asset "img/globalping.svg"}}" width="138" height="34" alt="Globalping">
            <span class="site-logo__section">Blog</span>
        </a>

        <div class="site-header__controls">
            <nav class="site-nav site-nav--desktop" aria-label="Primary navigation">
                <a href="{{@site.url}}"{{#is "home"}} aria-current="page"{{/is}}>Latest</a>
                <a href="{{@site.url}}/tag/announcement/"{{#is "tag"}}{{#match tag.slug "announcement"}} aria-current="page"{{/match}}{{/is}}>Announcements</a>
                <a href="{{@site.url}}/tag/news/"{{#is "tag"}}{{#match tag.slug "news"}} aria-current="page"{{/match}}{{/is}}>Monthly recaps</a>
                <a href="{{@site.url}}/tag/tutorial/"{{#is "tag"}}{{#match tag.slug "tutorial"}} aria-current="page"{{/match}}{{/is}}>Guides</a>
                <a href="{{@site.url}}/about/"{{#is "page"}}{{#post}}{{#match slug "about"}} aria-current="page"{{/match}}{{/post}}{{/is}}>About</a>
            </nav>

            <div class="site-actions">
                <button class="icon-button site-actions__desktop" type="button" data-ghost-search aria-label="Search the blog">
                    <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                        <circle cx="11" cy="11" r="7"></circle>
                        <path d="m20 20-4-4"></path>
                    </svg>
                </button>
                <a class="button button--primary button--globalping site-actions__desktop" href="https://globalping.io/">globalping.io</a>
                <details class="mobile-menu">
					<summary aria-label="Navigation menu">
                        <span class="menu-icon" aria-hidden="true"><span></span><span></span><span></span></span>
                    </summary>
                    <nav aria-label="Mobile navigation">
                        <a href="{{@site.url}}"{{#is "home"}} aria-current="page"{{/is}}>Latest</a>
                        <a href="{{@site.url}}/tag/announcement/"{{#is "tag"}}{{#match tag.slug "announcement"}} aria-current="page"{{/match}}{{/is}}>Announcements</a>
                        <a href="{{@site.url}}/tag/news/"{{#is "tag"}}{{#match tag.slug "news"}} aria-current="page"{{/match}}{{/is}}>Monthly recaps</a>
                        <a href="{{@site.url}}/tag/tutorial/"{{#is "tag"}}{{#match tag.slug "tutorial"}} aria-current="page"{{/match}}{{/is}}>Guides</a>
                        <a href="{{@site.url}}/about/"{{#is "page"}}{{#post}}{{#match slug "about"}} aria-current="page"{{/match}}{{/post}}{{/is}}>About</a>
                        <button class="mobile-menu__search" type="button" data-ghost-search>
                            <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                                <circle cx="11" cy="11" r="7"></circle>
                                <path d="m20 20-4-4"></path>
                            </svg>
                            Search
                        </button>
                        <a class="button button--primary button--globalping mobile-menu__cta" href="https://globalping.io/">globalping.io</a>
                    </nav>
                </details>
            </div>
        </div>
    </div>
</header>
