<article class="post-card">
	<a class="post-card__link" href="{{url}}">
		<h3 class="post-card__title">{{{title}}}</h3>
		{{#if feature_image}}
			<span class="post-card__image">
				<img
					src="{{img_url feature_image size="m"}}"
					srcset="{{img_url feature_image size="s"}} 360w, {{img_url feature_image size="m"}} 720w, {{img_url feature_image size="l"}} 1200w, {{img_url feature_image size="xl"}} 2000w"
					sizes="(max-width: 700px) calc(100vw - 68px), (max-width: 1279px) 726px, (max-width: 1320px) calc((100vw - 192px) / 2), 564px"
					alt=""
					loading="{{#if priority}}eager{{else}}lazy{{/if}}"
					fetchpriority="{{#if priority}}high{{else}}auto{{/if}}"
					width="1200"
					height="450">
			</span>
		{{/if}}
		<p class="post-card__excerpt">{{excerpt words="60"}}</p>
		<div class="post-card__meta">
			<span class="topic-badge">
				{{#has tag="announcement"}}Announcements{{else}}{{#has tag="news"}}Monthly recaps{{else}}{{#has tag="tutorial"}}Guides{{else}}Globalping{{/has}}{{/has}}{{/has}}
			</span>
			<time datetime="{{date format='YYYY-MM-DD'}}">{{date format="DD MMM YYYY"}}</time>
			<span aria-hidden="true">·</span>
			<span>{{reading_time}}</span>
		</div>
	</a>
</article>
